# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# YOXA Integration - CRITICAL: Keep these secret!
YOXA_TRIGGER_URL=
YOXA_DEPLOYMENT_SECRET=
YOXA_DEPLOYMENT_ID=
YOXA_API_BASE=

# YOXA HITL Integration
YOXA_HITL_WEBHOOK_SIGNING_SECRET=
YOXA_HITL_RESPONSE_SECRET=

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Signs doctor/patient session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret YOXA must send as `Authorization: Bearer <key>` on every
# /api/yoxa/* tool call. Configure the SAME value as the Bearer token for
# every connector in the YOXA platform UI before setting this, or YOXA's
# tool calls will start failing with 401. Leave unset to keep /api/yoxa/*
# endpoints open (current behavior) until you're ready to coordinate both sides.
YOXA_TOOLS_API_KEY=
